# Copy this file to .env and fill in your own values. Never commit .env.

# --- MySQL 8 connection
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=insider_threat_system

# --- Flask
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
# Set to 1 when served over HTTPS
SESSION_COOKIE_SECURE=0
SESSION_TIMEOUT_MINUTES=30
# Set to 1 only when running behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=0

# --- Monitoring policy (optional overrides)
WORK_HOURS_START=9
WORK_HOURS_END=19
RISK_DECAY_PER_HOUR=2
LOGIN_MAX_FAILURES=5
LOGIN_IP_MAX_FAILURES=20
LOGIN_LOCKOUT_MINUTES=15
